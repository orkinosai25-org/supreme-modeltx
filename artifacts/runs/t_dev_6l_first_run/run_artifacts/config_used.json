{
  "model": {
    "model_family": "t-series",
    "model_variant": "t-dev-6l",
    "version": "0.1.0",
    "vocab_size": 512,
    "hidden_size": 256,
    "num_hidden_layers": 6,
    "num_attention_heads": 8,
    "num_key_value_heads": 8,
    "intermediate_size": 1024,
    "max_position_embeddings": 128,
    "rms_norm_eps": 0.00001,
    "rope_theta": 10000.0,
    "hidden_act": "swiglue",
    "tie_word_embeddings": false,
    "torch_dtype": "float32",
    "initializer_range": 0.02,
    "pad_token_id": 0,
    "bos_token_id": 1,
    "eos_token_id": 2
  },
  "training": {
    "max_steps": 20,
    "batch_size": 2,
    "gradient_accumulation_steps": 1,
    "seed": 42,
    "checkpoint": {
      "save_dir": "artifacts/runs/t_dev_6l_first_run/checkpoints",
      "save_every_n_steps": 10,
      "keep_last_n": 2,
      "resume_from": null
    },
    "precision": {
      "enabled": false,
      "dtype": "float32"
    },
    "optimizer": {
      "name": "adamw",
      "lr": 0.0003,
      "weight_decay": 0.01,
      "beta1": 0.9,
      "beta2": 0.95,
      "eps": 1e-8,
      "grad_clip": 1.0
    },
    "scheduler": {
      "name": "constant",
      "warmup_steps": 0,
      "min_lr_ratio": 1.0
    },
    "distributed": {
      "backend": "auto",
      "fsdp_enabled": false,
      "fsdp_sharding_strategy": "full"
    },
    "log_every_n_steps": 5,
    "eval_every_n_steps": 10,
    "eval_max_batches": 4
  },
  "data": {
    "manifest_path": "artifacts/runs/t_dev_6l_first_run/manifest.yaml",
    "train_split": "train",
    "validation_split": "validation",
    "data_dirs": [],
    "format": "jsonl",
    "hf_dataset_name": null,
    "hf_dataset_split": "train",
    "max_seq_len": 128,
    "pack_sequences": true,
    "num_workers": 4,
    "tokenizer_path": "artifacts/tokenizers/t-dev-6l/t-dev-6l/v-first-run/tokenizer.model"
  },
  "tokenizer": {
    "backend": "sentencepiece",
    "model_path": "artifacts/tokenizers/t-dev-6l/t-dev-6l/v-first-run/tokenizer.model",
    "vocab_size": 32000,
    "pad_token": "<pad>",
    "bos_token": "<s>",
    "eos_token": "</s>",
    "unk_token": "<unk>"
  }
}