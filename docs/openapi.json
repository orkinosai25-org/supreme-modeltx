  "components": {
    "schemas": {
      "ChatChoice": {
        "properties": {
          "index": {
            "type": "integer",
            "title": "Index"
          },
          "message": {
            "$ref": "#/components/schemas/ChatMessage"
          },
          "finish_reason": {
            "type": "string",
            "title": "Finish Reason"
          }
        },
        "type": "object",
        "required": [
          "index",
          "message",
          "finish_reason"
        ],
        "title": "ChatChoice"
      },
      "ChatCompletionRequest": {
        "properties": {
          "model": {
            "type": "string",
            "title": "Model",
            "description": "Model identifier to use for completion.",
            "default": "t101"
          },
          "messages": {
            "items": {
              "$ref": "#/components/schemas/ChatMessage"
            },
            "type": "array",
            "minItems": 1,
            "title": "Messages"
          },
          "max_tokens": {
            "type": "integer",
            "maximum": 4096.0,
            "minimum": 1.0,
            "title": "Max Tokens",
            "default": 512
          },
          "temperature": {
            "type": "number",
            "maximum": 2.0,
            "minimum": 0.0,
            "title": "Temperature",
            "default": 0.7
          },
          "top_p": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Top P",
            "default": 0.95
          },
          "stream": {
            "type": "boolean",
            "title": "Stream",
            "description": "Streaming is reserved for a future release.",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "messages"
        ],
        "title": "ChatCompletionRequest",
        "examples": [
          {
            "max_tokens": 256,
            "messages": [
              {
                "content": "You are a helpful AI assistant.",
                "role": "system"
              },
              {
                "content": "Explain transformer architecture in two sentences.",
                "role": "user"
              }
            ],
            "model": "t101",
            "stream": false,
            "temperature": 0.7,
            "top_p": 0.95
          }
        ]
      },
      "ChatCompletionResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "object": {
            "type": "string",
            "title": "Object",
            "default": "chat.completion"
          },
          "created": {
            "type": "integer",
            "title": "Created",
            "description": "Unix timestamp of creation."
          },
          "model": {
            "type": "string",
            "title": "Model"
          },
          "choices": {
            "items": {
              "$ref": "#/components/schemas/ChatChoice"
            },
            "type": "array",
            "title": "Choices"
          },
          "usage": {
            "$ref": "#/components/schemas/ChatUsage"
          }
        },
        "type": "object",
        "required": [
          "created",
          "model",
          "choices",
          "usage"
        ],
        "title": "ChatCompletionResponse",
        "examples": [
          {
            "choices": [
              {
                "finish_reason": "stop",
                "index": 0,
                "message": {
                  "content": "A transformer uses self-attention to weigh token relationships...",
                  "role": "assistant"
                }
              }
            ],
            "created": 1704067200,
            "id": "chatcmpl_a1b2c3d4",
            "model": "t101",
            "object": "chat.completion",
            "usage": {
              "completion_tokens": 42,
              "prompt_tokens": 30,
              "total_tokens": 72
            }
          }
        ]
      },
      "ChatMessage": {
        "properties": {
          "role": {
            "type": "string",
            "pattern": "^(system|user|assistant)$",
            "title": "Role",
            "description": "Message author role."
          },
          "content": {
            "type": "string",
            "title": "Content",
            "description": "Message text content."
          }
        },
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "title": "ChatMessage"
      },
      "ChatUsage": {
        "properties": {
          "prompt_tokens": {
            "type": "integer",
            "title": "Prompt Tokens"
          },
          "completion_tokens": {
            "type": "integer",
            "title": "Completion Tokens"
          },
          "total_tokens": {
            "type": "integer",
            "title": "Total Tokens"
          }
        },
        "type": "object",
        "required": [
          "prompt_tokens",
          "completion_tokens",
          "total_tokens"
        ],
        "title": "ChatUsage"
      },
      "Deployment": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "project_id": {
            "type": "string",
            "title": "Project Id"
          },
          "model_id": {
            "type": "string",
            "title": "Model Id"
          },
          "azure_region": {
            "type": "string",
            "title": "Azure Region"
          },
          "vm_sku": {
            "type": "string",
            "title": "Vm Sku"
          },
          "min_replicas": {
            "type": "integer",
