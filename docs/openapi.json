            "title": "Endpoint Url"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          }
        },
        "type": "object",
        "required": [
          "project_id",
          "model_id",
          "azure_region",
          "vm_sku",
          "min_replicas",
          "max_replicas",
          "environment"
