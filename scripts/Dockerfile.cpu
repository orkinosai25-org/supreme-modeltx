FROM python:3.11-slim

LABEL maintainer="SMTX Project" \
      version="0.3.0" \
      description="SMTX T-101 CPU-first training container (torch.distributed + Gloo, no GPU required)"

WORKDIR /workspace

# Install system dependencies
# net-tools / iproute2 needed for Gloo interface detection in distributed mode
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    wget \
    curl \
    build-essential \
    net-tools \
    iproute2 \
    && rm -rf /var/lib/apt/lists/*

# Install CPU-only PyTorch first (no CUDA wheels — smaller image, no GPU dependency)
RUN pip install --no-cache-dir \
    torch==2.3.0 \
    torchvision==0.18.0 \
    --index-url https://download.pytorch.org/whl/cpu

# Install remaining training dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir \
    transformers>=4.40.0 \
    datasets>=2.19.0 \
    accelerate>=0.29.0 \
    sentencepiece>=0.2.0 \
    tokenizers>=0.19.0 \
    peft>=0.10.0 \
    pydantic>=2.0.0 \
    azure-storage-blob>=12.20.0 \
    azure-identity>=1.16.0

# Copy project source
COPY . /workspace

# Create mount points expected by Azure Batch file-share mounts
RUN mkdir -p /mnt/checkpoints /mnt/data/raw /mnt/data/processed

ENV PYTHONPATH=/workspace \
    TOKENIZERS_PARALLELISM=false \
    # Default: single-node CPU; override with TRAINING_PROFILE=cpu-distributed
    # for multi-node Gloo runs launched by torchrun.
    TRAINING_PROFILE=cpu-single-node \
    OMP_NUM_THREADS=1 \
    # Gloo uses TCP; set the correct interface for multi-node Azure Batch pools.
    GLOO_SOCKET_IFNAME=eth0

# Training is driven by scripts/run_training.sh.
# Override via environment variables:
#   TRAINING_PROFILE, CHECKPOINT_DIR, DATA_INPUT_DIR, DATA_OUTPUT_DIR,
#   NUM_NODES, NUM_PROCS_PER_NODE, MASTER_ADDR, MASTER_PORT,
#   SKIP_DATASET, CONFIG
ENTRYPOINT ["bash", "scripts/run_training.sh"]
