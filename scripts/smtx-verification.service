[Unit]
Description=SMTX T-501 Verification Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=smtx
Group=smtx
WorkingDirectory=/opt/smtx
EnvironmentFile=-/etc/smtx/verification.env

ExecStart=/opt/smtx-venv/bin/python /opt/smtx/inference/verification_service.py \
    --model-name ${VERIFICATION_MODEL:-all-MiniLM-L6-v2} \
    --host 0.0.0.0 \
    --port 8002

Restart=on-failure
RestartSec=10s

LimitNOFILE=65536

StandardOutput=journal
StandardError=journal
SyslogIdentifier=smtx-verification

[Install]
WantedBy=multi-user.target
