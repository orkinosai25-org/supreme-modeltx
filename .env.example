# Supreme ModelTX — Environment Variables
#
# Copy this file to .env and fill in values appropriate for your environment.
# Never commit .env to version control.
#
# Usage:
#   cp .env.example .env
#   # Edit .env with your values
#   source .env   (or use a tool like python-dotenv)

# ---------------------------------------------------------------------------
# Platform API — Authentication
# ---------------------------------------------------------------------------

# Master API key used by the platform API for dev/local access.
# In production, issue per-project keys via the /auth/keys endpoint.
SMTX_API_KEY=dev-secret

# Salt used when hashing API keys. Change for any non-local environment.
SMTX_KEY_SALT=supreme-modeltx-default-dev-salt-2026

# Default project ID for the dev API key.
SMTX_DEV_PROJECT_ID=dev-project

# ---------------------------------------------------------------------------
# Platform API — Database
# ---------------------------------------------------------------------------

# Path for the SQLite platform database.
# Defaults to platform_api.db in the repo root if not set.
# SUPREME_MODELTX_PLATFORM_DB_PATH=./platform_api.db

# ---------------------------------------------------------------------------
# Inference Engine
# ---------------------------------------------------------------------------

# Path to a trained model checkpoint (.pt file).
# Required to serve inference via the API or run evaluate.sh with checkpoint.
# SMTX_CHECKPOINT_PATH=artifacts/runs/t_dev_6l_first_run/checkpoints/step_100.pt

# Path to a trained SentencePiece tokenizer model file.
# SMTX_TOKENIZER_PATH=artifacts/tokenizers/t-dev-6l/v1/tokenizer.model

# Path to the model JSON config (optional — inferred from run artifacts if not set).
# SMTX_MODEL_CONFIG_PATH=configs/real_training/t_dev_6l_first_run.json

# Inference dtype. Options: bfloat16 | float16 | float32
# SMTX_INFERENCE_DTYPE=bfloat16

# Model identifier shown in API responses.
# SMTX_MODEL_ID=t-dev-6l-v1

# Human-readable model name.
# SMTX_MODEL_NAME=T-Dev-6L

# Deployment stage for the served model. Options: development | staging | production
# SMTX_MODEL_STAGE=development

# ---------------------------------------------------------------------------
# Training — Device Override
# ---------------------------------------------------------------------------

# Force a specific device. Options: cpu | cuda | mps
# Defaults to auto-detect (cuda > mps > cpu).
# SMTX_DEVICE=cpu

# ---------------------------------------------------------------------------
# Distributed Training (multi-node)
# ---------------------------------------------------------------------------

# Set automatically by torchrun / DeepSpeed launchers.
# Do not set manually unless you know what you are doing.
# WORLD_SIZE=1
# RANK=0
# LOCAL_RANK=0

# ---------------------------------------------------------------------------
# Azure / Cloud (for GPU experiment workflows)
# ---------------------------------------------------------------------------

# Azure resource group for provisioning scripts.
# AZURE_RESOURCE_GROUP=smtx-rg

# Azure region. UK South or UK West for sovereignty.
# AZURE_LOCATION=uksouth

# Azure subscription ID.
# AZURE_SUBSCRIPTION_ID=

# Azure storage account name (for checkpoint and artifact storage).
# AZURE_STORAGE_ACCOUNT=
