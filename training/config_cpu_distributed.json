{
  "_comment": "CPU distributed training profile. Uses torch.distributed with Gloo backend across multiple nodes. Set WORLD_SIZE, RANK, MASTER_ADDR, MASTER_PORT in the environment. Uses LoRA adapters by default (use_peft=true) to keep gradient sync cost low.",
  "profile": "cpu-distributed",
  "model_name": "t101-7b",
  "model_config": "tmodels/t101",
  "training": {
    "output_dir": "checkpoints/t101-cpu-dist",
    "num_train_epochs": 3,
    "per_device_train_batch_size": 1,
    "gradient_accumulation_steps": 32,
    "learning_rate": 2e-4,
    "lr_scheduler_type": "cosine",
    "warmup_ratio": 0.03,
    "weight_decay": 0.01,
    "max_grad_norm": 1.0,
    "bf16": false,
    "fp16": false,
    "logging_steps": 10,
    "save_steps": 100,
    "save_total_limit": 2,
    "seed": 42,
    "dataloader_num_workers": 2,
    "use_peft": true
  },
  "data": {
    "train_file": "data/train.jsonl",
    "validation_file": "data/val.jsonl",
    "max_seq_length": 512,
    "preprocessing_num_workers": 2
  },
  "peft": {
    "lora_r": 16,
    "lora_alpha": 32,
    "lora_dropout": 0.05,
    "target_modules": ["q_proj", "v_proj"]
  },
  "distributed": {
    "backend": "gloo",
    "timeout_minutes": 30
  }
}
