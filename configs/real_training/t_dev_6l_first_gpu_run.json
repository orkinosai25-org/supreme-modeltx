{
  "model": {
    "model_variant": "t-dev-6l",
    "vocab_size": 32000,
    "hidden_size": 512,
    "num_hidden_layers": 6,
    "num_attention_heads": 8,
    "num_key_value_heads": 8,
    "intermediate_size": 2048,
    "max_position_embeddings": 512,
    "torch_dtype": "bfloat16",
    "pad_token_id": 3,
    "bos_token_id": 1,
    "eos_token_id": 2
  },
  "tokenizer": {
    "backend": "sentencepiece",
    "model_path": "artifacts/tokenizers/t-dev-6l/t-dev-6l/v1/tokenizer.model"
  },
  "data": {
    "manifest_path": "data/manifests/t_dev_6l_expanded_run.yaml",
    "train_split": "train",
    "validation_split": "validation",
    "tokenizer_path": "artifacts/tokenizers/t-dev-6l/t-dev-6l/v1/tokenizer.model",
    "max_seq_len": 512,
    "pack_sequences": true
  },
  "training": {
    "seed": 42,
    "max_steps": 1000,
    "batch_size": 8,
    "gradient_accumulation_steps": 4,
    "log_every_n_steps": 20,
    "eval_every_n_steps": 100,
    "eval_max_batches": 16,
    "precision": {
      "enabled": true,
      "dtype": "bfloat16"
    },
    "optimizer": {
      "name": "adamw",
      "lr": 0.0003,
      "weight_decay": 0.1,
      "beta1": 0.9,
      "beta2": 0.95,
      "eps": 1e-8,
      "grad_clip": 1.0
    },
    "scheduler": {
      "name": "cosine",
      "warmup_steps": 100,
      "min_lr_ratio": 0.1
    },
    "checkpoint": {
      "save_dir": "artifacts/runs/t_dev_6l_first_gpu_run/checkpoints",
      "save_every_n_steps": 100,
      "keep_last_n": 5
    },
    "distributed": {
      "backend": "auto",
      "fsdp_enabled": false,
      "fsdp_sharding_strategy": "full"
    }
  }
}
