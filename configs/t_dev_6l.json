{
  "model": {
    "model_family": "t-series",
    "model_variant": "t-dev-6l",
    "version": "0.1.0",
    "vocab_size": 32000,
    "hidden_size": 512,
    "num_hidden_layers": 6,
    "num_attention_heads": 8,
    "num_key_value_heads": 8,
    "intermediate_size": 2048,
    "max_position_embeddings": 512,
    "rms_norm_eps": 1e-5,
    "rope_theta": 10000.0,
    "hidden_act": "swiglue",
    "tie_word_embeddings": false,
    "torch_dtype": "bfloat16",
    "initializer_range": 0.02,
    "pad_token_id": 0,
    "bos_token_id": 1,
    "eos_token_id": 2
  },
  "training": {
    "max_steps": 10000,
    "batch_size": 8,
    "gradient_accumulation_steps": 4,
    "seed": 42,
    "log_every_n_steps": 50,
    "eval_every_n_steps": 500,
    "checkpoint": {
      "save_dir": "checkpoints/t-dev-6l",
      "save_every_n_steps": 500,
      "keep_last_n": 3
    },
    "precision": {
      "enabled": true,
      "dtype": "bfloat16"
    },
    "optimizer": {
      "name": "adamw",
      "lr": 3e-4,
      "weight_decay": 0.1,
      "beta1": 0.9,
      "beta2": 0.95,
      "eps": 1e-8,
      "grad_clip": 1.0
    },
    "scheduler": {
      "name": "cosine",
      "warmup_steps": 200,
      "min_lr_ratio": 0.1
    },
    "distributed": {
      "backend": "auto",
      "fsdp_enabled": false
    }
  },
  "data": {
    "format": "jsonl",
    "data_dirs": ["data/raw"],
    "max_seq_len": 512,
    "pack_sequences": true,
    "num_workers": 4
  },
  "tokenizer": {
    "backend": "sentencepiece",
    "vocab_size": 32000,
    "pad_token": "<pad>",
    "bos_token": "<s>",
    "eos_token": "</s>",
    "unk_token": "<unk>"
  }
}
